:{$PORT:80} {
	root * /srv
	encode gzip zstd

	# The legal pages are linked from inside the apps and must never be indexed.
	header /legal/* X-Robots-Tag "noindex, nofollow"

	# Fonts and images are content-hashed by name and never change in place.
	@immutable path /assets/fonts/* /assets/icons/* /assets/shots/* /assets/art/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header /*.html Cache-Control "public, max-age=300"

	file_server
	try_files {path} {path}/ {path}.html
}
